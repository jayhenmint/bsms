# Copy to env/.env.local. Existing server/process variables override these settings.
# Values are literal, optionally quoted. Put comments on their own lines.
CI_ENV=development
APP_URL=http://book.localhost/
APP_INDEX_PAGE=index.php
APP_TIMEZONE=Asia/Manila
# Generate locally: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_ENCRYPTION_KEY=
COOKIE_SECURE=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ci_bsms_db
DB_USERNAME=root
DB_PASSWORD=

# Optional absolute path; defaults to application/cache/sessions.
# SESSION_SAVE_PATH="H:/forexmart_local_pc/htdocs/bsms_ci/application/cache/sessions"
