# Copy to env/.env.prod and fill in production credentials.
# Select this file by setting CI_ENV=production in the server environment.
# Production hostname: book.prod.
CI_ENV=production
APP_URL=https://book.prod/
APP_INDEX_PAGE=index.php
APP_TIMEZONE=Asia/Manila
# Generate a separate production key: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_ENCRYPTION_KEY=
COOKIE_SECURE=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ci_bsms_db
DB_USERNAME=bsms_app
DB_PASSWORD=

# Optional absolute path to a writable session directory on the server.
# SESSION_SAVE_PATH=/var/lib/bsms/sessions
